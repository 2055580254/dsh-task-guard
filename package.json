{
  "name": "dsh-task-guard",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "任务闸门：方案先准许再动手 + 计划表与 progress + 全局边界与 skill 限制 + 新指令终止/追加判定",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "guardrail",
    "approval",
    "agent-safety"
  ],
  "license": "MIT",
  "author": "YG",
  "homepage": "https://github.com/2055580254/dsh-task-guard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2055580254/dsh-task-guard.git"
  },
  "bugs": {
    "url": "https://github.com/2055580254/dsh-task-guard/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/policy.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "docs/config.md",
    "docs/architecture.md",
    "docs/install.md",
    "docs/publish.md",
    "docs/habits.example.json",
    "scripts/selftest.mjs",
    "scripts/publish.ps1",
    "scripts/publish.sh",
    "scripts/set-owner.ps1"
  ],
  "scripts": {
    "selftest": "node scripts/selftest.mjs",
    "check": "node --check index.js && node --check lib/policy.js && node scripts/selftest.mjs",
    "publish:dry": "pwsh -File scripts/publish.ps1 -User 2055580254 -DryRun"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
